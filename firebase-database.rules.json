{
  "rules": {
    "owner": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'rohithkp1901@gmail.com'"
    },
    "visitors": {
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".read": "auth != null && auth.token.email == 'rohithkp1901@gmail.com'",
        ".validate": "newData.hasChildren(['name','latitude','longitude','online']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('latitude').isNumber() && newData.child('longitude').isNumber() && newData.child('online').isBoolean()"
      }
    }
  }
}
